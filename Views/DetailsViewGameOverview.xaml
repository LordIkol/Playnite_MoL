                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <TranslateTransform Y="{Binding ElementName=PART_ScrollViewHost, Path=VerticalOffset, Converter={PluginConverter Plugin=MythosHelper_Loki, Converter=TopFixedOffsetConverter}}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <StackPanel>
                                        <!-- ACTION & STATUS ROW -->
                                        <Grid>
                                            <Border Background="{DynamicResource DetailsSectionBackgroundBrush}"/>
                                    <Border Background="{DynamicResource BackdropGlass1}"/>
                                    <Border Padding="40,14,40,14" MinHeight="68" x:Name="HeaderRow"
                                            BorderBrush="{DynamicResource ContentBorderBrushOverlay}"
                                            BorderThickness="0,1,0,1">
                                        <DockPanel LastChildFill="True">
                                            
                                            <!-- LEFT ACTIONS: Play, Install/Context, More Actions -->
                                            <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,30,0" DockPanel.Dock="Left">
                                                <Button Name="PART_ButtonPlayAction" Style="{DynamicResource PlayButton}" />
                                                <Button Name="PART_ButtonContextAction" Style="{DynamicResource ContextButton}" Margin="8,0,0,0"/>
                                                <Button Name="PART_ButtonMoreActions" Style="{DynamicResource MoreActionsButton}" Margin="8,0,0,0"/>
                                            </DockPanel>

                                            <!-- RIGHT QUICK TOOLS: Edit Game, Panel Toggle, Favorite Toggle, PlayState -->
                                            <DockPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="25,0,0,0">
                                                <ContentControl x:Name="PlayState_GameStateSwitchControl" Margin="8,0,0,0"
                                                                Visibility="{PluginSettings Plugin=PlayState, Path=IsControlVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ContentControl.Resources>
                                                        <Style TargetType="Button" BasedOn="{StaticResource DetailsSemiTransparentButton}">
                                                            <Setter Property="Width" Value="36" />
                                                            <Setter Property="Height" Value="36" />
                                                        </Style>
                                                    </ContentControl.Resources>
                                                </ContentControl>
                                                <Button x:Name="PART_ButtonEditGame" Focusable="False" Height="36" Width="36"
                                                        Style="{DynamicResource DetailsViewEditButton}" Margin="8,0,0,0"/>
                                                <ToggleButton Name="PanelToggleButton" Margin="8,0,0,0" Focusable="False" Height="36" Width="36"
                                                              Style="{DynamicResource PannelToggleButton}" IsChecked="{DynamicResource DetailsViewShowInfoPanelDefault}"/>
                                                <ToggleButton Name="GameFavoriteToggleButton" Margin="8,0,0,0" Focusable="False" Height="36" Width="36"
                                                              Style="{DynamicResource PannelFavoriteToggleButton}"
                                                              Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin}"
                                                              IsChecked="{PluginSettings Plugin=ThemeExtras, Path=Game.Favorite, Mode=TwoWay, FallbackValue={StaticResource False}}"/>
                                                <ToggleButton Name="ToggleChipsRowButton" Margin="8,0,0,0" Focusable="False" Height="36" Width="36"
                                                              IsChecked="True"
                                                              ToolTip="{DynamicResource LOCMythos_Tags}"
                                                              Style="{DynamicResource DetailsSemiTransparentToggleButton}">
                                                    <TextBlock Text="&#xE8EC;"
                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="16"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                </ToggleButton>
                                            </DockPanel>

                                            <!-- CENTER STATUS METADATA: Last Played, Time Played, Install Size, Install Folder, Completion Status -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                
                                                <!-- LAST PLAYED -->
                                                <DockPanel x:Name="PART_ElemLastPlayed" VerticalAlignment="Center" Margin="10,0,25,0"
                                                           Visibility="{PluginSettings Plugin=MythosHelper_Loki, Path=ShowLastPlayed, FallbackValue=Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="16" Foreground="{DynamicResource DetailsViewHeaderIconsFillBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Label Style="{DynamicResource HeaderLabel}" Content="{DynamicResource LOCMythos_RecentActivity}"/>
                                                        <TextBlock x:Name="PART_TextLastActivity" Style="{DynamicResource HeaderTextBlock}"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- TIME PLAYED -->
                                                <DockPanel x:Name="PART_ElemPlayTime" VerticalAlignment="Center" Margin="10,0,25,0"
                                                           Visibility="{PluginSettings Plugin=MythosHelper_Loki, Path=ShowTimePlayed, FallbackValue=Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="16" Foreground="{DynamicResource DetailsViewHeaderIconsFillBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Label Style="{DynamicResource HeaderLabel}" Content="{DynamicResource LOCMythos_PlayTime}"/>
                                                        <TextBlock x:Name="PART_TextPlayTime" Style="{DynamicResource HeaderTextBlock}"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- INSTALL SIZE -->
                                                <DockPanel x:Name="PART_ElemInstallSize" VerticalAlignment="Center" Margin="10,0,25,0"
                                                           Visibility="{PluginSettings Plugin=MythosHelper_Loki, Path=ShowInstallSize, FallbackValue=Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="16" Foreground="{DynamicResource DetailsViewHeaderIconsFillBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Label Style="{DynamicResource HeaderLabel}" Content="{DynamicResource LOCInstallSizeLabel}"/>
                                                        <TextBlock x:Name="PART_TextInstallSize" Style="{DynamicResource HeaderTextBlock}"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- INSTALL DIRECTORY -->
                                                <DockPanel x:Name="PART_ElemInstallDirectory" VerticalAlignment="Center" Margin="10,0,25,0"
                                                           Visibility="{PluginSettings Plugin=MythosHelper_Loki, Path=ShowInstallFolder, FallbackValue=Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="&#xED25;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="16" Foreground="{DynamicResource DetailsViewHeaderIconsFillBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Label Style="{DynamicResource HeaderLabel}" Content="{DynamicResource LOCGameInstallDirTitle}"/>
                                                        <Button x:Name="PART_ButtonInstallDirectory" MaxWidth="180" Cursor="Hand" Margin="0" Style="{DynamicResource PropertyItemButton}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <TextBlock FontSize="{DynamicResource FontSize}" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource DetailsViewOverviewHeaderTextBlockBrush}"
                                                                               Text="{TemplateBinding Content, Converter={StaticResource ObjectToStringConverter}}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- COMPLETION STATUS -->
                                                <StackPanel x:Name="PART_ElemCompletionStatus" VerticalAlignment="Center" Margin="10,0,20,0"
                                                            Visibility="{PluginSettings Plugin=MythosHelper_Loki, Path=ShowCompletionStatus, FallbackValue=Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Label Style="{DynamicResource HeaderLabel}" Content="{DynamicResource LOCMythos_CompStatus}"/>
                                                    <Border Tag="{PluginStatus Plugin=felixkmh_Extras_Plugin, Status=Installed}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Button Name="PART_ButtonCompletionStatus" Style="{DynamicResource PropertyItemButton}" Margin="0" />
                                                    </Border>
                                                    <ContentControl Visibility="{PluginStatus Plugin=felixkmh_Extras_Plugin, Status=Installed}"
                                                                    x:Name="ThemeExtras_SettableCompletionStatus">
                                                        <ContentControl.Resources>
                                                            <Style TargetType="UserControl" BasedOn="{StaticResource ThemeExtrasUserControlCompStatusStyle}" />
                                                        </ContentControl.Resources>
                                                    </ContentControl>
                                                </StackPanel>

                                            </StackPanel>

                                        </DockPanel>
                                    </Border>
                                        </Grid>

                                        <!-- ATTACHED FIXED & HIDABLE CHIPS & FILTER BAR -->
                                        <Grid x:Name="AttachedChipsBar"
                                              Visibility="{Binding ElementName=ToggleChipsRowButton, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border Background="#16161A"/>
                                            <Border Background="{DynamicResource BackdropGlass1}"/>
                                            <Border BorderBrush="{DynamicResource ContentBorderBrushOverlay}" BorderThickness="0,1,0,1" Padding="40,6,40,6">
                                                <DockPanel LastChildFill="True">
                                                    <!-- QUICK FILTER ACTION BUTTONS (Clear & Match All) -->
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,20,0">
                                                        <!-- Clear Filters Button (with plugin & native fallback support) -->
                                                        <Button Style="{StaticResource DetailsClearFilterButton}"
                                                                Height="34" Width="34" Margin="0,0,6,0"/>

                                                        <!-- Toggle Match All Filters Button -->
                                                        <ToggleButton ToolTip="{DynamicResource LOCFilterMatchAll}"
                                                                      IsChecked="{Settings FilterSettings.UseAndFilteringStyle, Mode=TwoWay}"
                                                                      Style="{StaticResource DetailsSemiTransparentToggleButton}"
                                                                      Height="34" Width="34" Margin="0,0,0,0"
                                                                      Cursor="Hand">
                                                            <TextBlock Text="&#xE8B1;"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="14"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"/>
                                                        </ToggleButton>
                                                    </StackPanel>

                                                    <!-- COLLAPSIBLE CHIPS WRAPPANEL (Horizontally and Vertically Centered) -->
                                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        
                                                        <!-- Series Group -->
                                                        <WrapPanel Orientation="Horizontal" Margin="0,2,24,2" VerticalAlignment="Center" Visibility="{Binding ElementName=PART_ElemSeries, Path=Visibility}">
                                                            <WrapPanel.Style>
                                                                <Style TargetType="WrapPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Settings DetailsVisibility.Series}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </WrapPanel.Style>
                                                            
                                                             <!-- Series Header Badge -->
                                                            <Border Background="#358A5CF6"
                                                                    BorderBrush="#80A855F7"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="6"
                                                                    Padding="8,5,10,5"
                                                                    Margin="0,2,8,2"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip="{DynamicResource LOCSeriesLabel}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="&#xE82D;"
                                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               FontSize="11"
                                                                               Foreground="#E9D5FF"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{DynamicResource LOCSeriesLabel}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="#FFFFFF"
                                                                               Margin="6,0,0,0"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Series Items -->
                                                            <ItemsControl x:Name="PART_ElemSeries" ItemsSource="{Binding Game.Series}" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding Name}"
                                                                                Tag="{Binding Converter={PluginConverter Plugin=MythosHelper_Loki, Converter=IsFilterActiveConverter}, ConverterParameter=Series}"
                                                                                Style="{StaticResource PropertyItemSeriesButton}"
                                                                                CommandParameter="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </WrapPanel>

                                                        <!-- Genres Group -->
                                                        <WrapPanel Orientation="Horizontal" Margin="0,2,24,2" VerticalAlignment="Center" Visibility="{Binding ElementName=PART_ElemGenres, Path=Visibility}">
                                                            <WrapPanel.Style>
                                                                <Style TargetType="WrapPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Settings DetailsVisibility.Genres}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </WrapPanel.Style>

                                                            <!-- Genres Header Badge -->
                                                            <Border Background="#350284C7"
                                                                    BorderBrush="#8038BDF8"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="6"
                                                                    Padding="8,5,10,5"
                                                                    Margin="0,2,8,2"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip="{DynamicResource LOCGenresLabel}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="&#xE790;"
                                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               FontSize="11"
                                                                               Foreground="#BAE6FD"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{DynamicResource LOCGenresLabel}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="#FFFFFF"
                                                                               Margin="6,0,0,0"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Genres Items -->
                                                            <ItemsControl x:Name="PART_ElemGenres" ItemsSource="{Binding Game.Genres}" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding Name}"
                                                                                Tag="{Binding Converter={PluginConverter Plugin=MythosHelper_Loki, Converter=IsFilterActiveConverter}, ConverterParameter=Genre}"
                                                                                Style="{StaticResource PropertyItemGenreButton}"
                                                                                CommandParameter="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </WrapPanel>

                                                        <!-- Features Group -->
                                                        <WrapPanel Orientation="Horizontal" Margin="0,2,24,2" VerticalAlignment="Center" Visibility="{Binding ElementName=PART_ElemFeatures, Path=Visibility}">
                                                            <WrapPanel.Style>
                                                                <Style TargetType="WrapPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Settings DetailsVisibility.Features}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </WrapPanel.Style>

                                                            <!-- Features Header Badge -->
                                                            <Border Background="#35059669"
                                                                    BorderBrush="#8034D399"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="6"
                                                                    Padding="8,5,10,5"
                                                                    Margin="0,2,8,2"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip="{DynamicResource LOCFeaturesLabel}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="&#xE768;"
                                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               FontSize="11"
                                                                               Foreground="#A7F3D0"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{DynamicResource LOCFeaturesLabel}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="#FFFFFF"
                                                                               Margin="6,0,0,0"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Features Items -->
                                                            <ItemsControl x:Name="PART_ElemFeatures" ItemsSource="{Binding Game.Features}" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding Name}"
                                                                                Tag="{Binding Converter={PluginConverter Plugin=MythosHelper_Loki, Converter=IsFilterActiveConverter}, ConverterParameter=Feature}"
                                                                                Style="{StaticResource PropertyItemFeatureButton}"
                                                                                CommandParameter="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </WrapPanel>

                                                        <!-- Categories Group -->
                                                        <WrapPanel Orientation="Horizontal" Margin="0,2,24,2" VerticalAlignment="Center" Visibility="{Binding ElementName=PART_ElemCategories, Path=Visibility}">
                                                            <WrapPanel.Style>
                                                                <Style TargetType="WrapPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Settings DetailsVisibility.Categories}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </WrapPanel.Style>

                                                            <!-- Categories Header Badge -->
                                                            <Border Background="#35D97706"
                                                                    BorderBrush="#80FBBF24"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="6"
                                                                    Padding="8,5,10,5"
                                                                    Margin="0,2,8,2"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip="{DynamicResource LOCGameCategoriesTitle}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="&#xE8B9;"
                                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               FontSize="11"
                                                                               Foreground="#FDE68A"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{DynamicResource LOCGameCategoriesTitle}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="#FFFFFF"
                                                                               Margin="6,0,0,0"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Categories Items -->
                                                            <ItemsControl x:Name="PART_ElemCategories" ItemsSource="{Binding Game.Categories}" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding Name}"
                                                                                Tag="{Binding Converter={PluginConverter Plugin=MythosHelper_Loki, Converter=IsFilterActiveConverter}, ConverterParameter=Category}"
                                                                                Style="{StaticResource PropertyItemCategoryButton}"
                                                                                CommandParameter="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </WrapPanel>

                                                        <!-- Tags Group -->
                                                        <WrapPanel Orientation="Horizontal" Margin="0,2,24,2" VerticalAlignment="Center" Visibility="{Binding ElementName=PART_ElemTags, Path=Visibility}">
                                                            <WrapPanel.Style>
                                                                <Style TargetType="WrapPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Settings DetailsVisibility.Tags}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </WrapPanel.Style>

                                                            <!-- Tags Header Badge -->
                                                            <Border Background="#25FFFFFF"
                                                                    BorderBrush="#60FFFFFF"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="6"
                                                                    Padding="8,5,10,5"
                                                                    Margin="0,2,8,2"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip="{DynamicResource LOCMythos_Tags}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="&#xE8EC;"
                                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               FontSize="11"
                                                                               Foreground="#CBD5E1"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{DynamicResource LOCMythos_Tags}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="#FFFFFF"
                                                                               Margin="6,0,0,0"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Tags Items -->
                                                            <ItemsControl x:Name="PART_ElemTags" ItemsSource="{Binding Game.Tags}" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding Name}"
                                                                                Tag="{Binding Converter={PluginConverter Plugin=MythosHelper_Loki, Converter=IsFilterActiveConverter}, ConverterParameter=Tag}"
                                                                                Style="{StaticResource PropertyItemTagButton}"
                                                                                CommandParameter="{Binding}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </WrapPanel>
                                                    </WrapPanel>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
