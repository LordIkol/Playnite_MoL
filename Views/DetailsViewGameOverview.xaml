<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type DetailsViewGameOverview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DetailsViewGameOverview}">
                    <Grid>
                        <ScrollViewer x:Name="PART_ScrollViewHost"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto" 
                                      Style="{DynamicResource DetailsScrollViewer}"
                                      d:DesignWidth="1280"
                                      d:DesignHeight="1280"
                                      d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameDetailsIntance}">
                            <Grid Margin="0,0,0,40">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ROW 0: HEADER BANNER IMAGE (MinHeight: 150px) -->
                                <Grid Grid.Row="0" Name="HeaderImagesGrid" Panel.ZIndex="9998" MinHeight="150" Height="{Settings CalculatedGameDetailsIndentation}"
                                      Tag="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight, Converter={PluginConverter Plugin=MythosHelper_Loki, Converter=SetAnchorHeightConverter}}">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="{Binding ElementName=PART_ScrollViewHost, Path=VerticalOffset, Converter={PluginConverter Plugin=MythosHelper_Loki, Converter=BannerOffsetConverter}}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <!-- Mode: BelowBanner (Keep Banner + Bar fixed at top) -->
                                                <DataTrigger Binding="{PluginSettings Plugin=MythosHelper_Loki, Path=HeaderMode}" Value="BelowBanner">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <TranslateTransform Y="{Binding ElementName=PART_ScrollViewHost, Path=VerticalOffset}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Border Background="#141417" />
                                        <!-- Background Image underlay -->
                                        <Grid Name="BorderImageBackground">
                                            <Grid.OpacityMask>
                                                <LinearGradientBrush StartPoint="0.5, 0.0" EndPoint="0.5, 1.0">
                                                    <GradientStop Color="Black" Offset="0.75"/>
                                                    <GradientStop Color="Transparent" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Grid.OpacityMask>
                                            <Grid Background="#141417">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Settings DetailsVisibility.BackgroundImage}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                            </Grid>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=HasDataBackground, FallbackValue=False}" Value="True" />
                                                                    <Condition Binding="{PluginSettings Plugin=BackgroundChanger, Path=EnableBackgroundImage, FallbackValue=False}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                                           HorizontalAlignment="{DynamicResource DetailsViewBackgroundHorizontalAlignment}"
                                                           VerticalAlignment="{DynamicResource DetailsViewBackgroundVerticalAlignment}" />
                                            </Border>

                                            <!-- BackgroundChanger plugin background -->
                                            <ContentControl x:Name="BackgroundChanger_PluginBackgroundImage"
                                                            HorizontalAlignment="{DynamicResource DetailsViewBackgroundHorizontalAlignment}"
                                                            VerticalAlignment="{DynamicResource DetailsViewBackgroundVerticalAlignment}" />
                                            
                                            <!-- Subtle Dark Overlay for contrast -->
                                            <Rectangle Fill="#55000000" IsHitTestVisible="False"/>
                                        </Grid>

                                        <!-- ExtraMetadata Video Player if enabled in banner -->
                                        <Border Panel.ZIndex="90" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableVideoPlayer, FallbackValue=False}" Value="True" />
                                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableAlternativeDetailsVideoPlayer, FallbackValue=False}" Value="True" />
                                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsAnyVideoAvailable, FallbackValue=False}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ContentControl x:Name="ExtraMetadataLoader_VideoLoaderControlAlternative" />
                                        </Border>

                                                                                <!-- Left-Aligned Cover Image in Banner (Full Height) -->
                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="40,20,20,20" Panel.ZIndex="100">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Settings DetailsVisibility.CoverImage}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Game.CoverImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Border Name="BannerCoverMask" Background="Black" CornerRadius="{DynamicResource GridCornerRadius}" />
                                            <Border CornerRadius="{DynamicResource GridCornerRadius}"
                                                    BorderBrush="{DynamicResource ContentBorderBrushOverlay}"
                                                    BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.7"/>
                                                </Border.Effect>
                                                <Image Name="PART_ImageCover"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Stretch"
                                                       RenderOptions.BitmapScalingMode="Fant"/>
                                            </Border>
                                            <Grid.OpacityMask>
                                                <VisualBrush Visual="{Binding ElementName=BannerCoverMask}" />
                                            </Grid.OpacityMask>
                                        </Grid>

<!-- Centered Game Logo / Title -->
                                        <Grid Panel.ZIndex="95" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,20,40,20">
                                            <!-- ExtraMetadataLoader Logo -->
                                            <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            MaxHeight="120" MaxWidth="600"
                                                            Tag="{DynamicResource DetailsViewAllowUseOfLogos}"
                                                            Style="{DynamicResource ControlPanelBoolTagToVisibility}"/>

                                            <!-- Centered Title Text (Fallback or when logo is not displayed) -->
                                            <Border Tag="{DynamicResource DetailsViewDisplayGameNameIfLogoVisible}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="False" />
                                                                    <Condition Binding="{Binding ElementName=ExtraMetadataLoader_LogoLoaderControl, Path=Visibility, FallbackValue=Collapsed}" Value="Visible" />
                                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontFamily="{DynamicResource TightFont}" Name="PART_TextDisplayName"
                                                           FontSize="{DynamicResource FontSizeLargest}"
                                                           FontWeight="Bold"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" Foreground="White">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="Black" ShadowDepth="0" Opacity="1"
                                                                          BlurRadius="12" Direction="0"
                                                                          RenderingBias="Performance" />
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                            </Border>
                                        </Grid>

                                        <!-- Top Left / Right Plugin Badges (DuplicateHider, Flags, Player Count) -->
                                        <StackPanel Margin="20,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="99">
                                            <ContentControl x:Name="CheckLocalizations_PluginFlags" Height="26" Margin="0,0,0,8"
                                                            Visibility="{PluginSettings Plugin=CheckLocalizations, Path=EnableIntegrationFlags, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Opacity="0.85" />
                                            <ContentControl x:Name="DuplicateHider_SourceSelector"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            VerticalContentAlignment="Center" Height="24"
                                                            RenderOptions.BitmapScalingMode="Fant" />
                                        </StackPanel>

                                        <StackPanel Margin="0,15,20,0" VerticalAlignment="Top" HorizontalAlignment="Right" Panel.ZIndex="99">
                                            <ContentControl x:Name="NewsViewer_PlayersInGameViewerControl"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <ContentControl.Resources>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PlayersCountButtonStyle}" />
                                                </ContentControl.Resources>
                                            </ContentControl>
                                            <Border Margin="0,8,0,0"
                                                    Background="{DynamicResource DetailsViewBannerPanelBackgroundBrush}"
                                                    BorderBrush="{DynamicResource DetailsViewBannerPanelBorderBrush}"
                                                    BorderThickness="1" Padding="6,2,6,2"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Visibility="{PluginSettings Plugin=GogSecondClassWatcher, Path=IsControlVisible, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ContentControl x:Name="GogSecondClassWatcher_SecondClassWatcherControl" />
                                            </Border>
                                            <!-- Age Rating in Top Right Corner of Banner -->
                                            <ItemsControl Name="PART_ElemAgeRating" ItemsSource="{Binding Game.AgeRatings}" Margin="0,8,0,0" HorizontalAlignment="Right">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#CC000000"
                                                                BorderBrush="{DynamicResource ContentBorderBrushOverlay}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="4"
                                                                Margin="4,0,0,0">
                                                            <Image x:Name="AgeRatingIcon"
                                                                   Height="{Binding ElementName=HeaderImagesGrid, Path=ActualHeight, Converter={PluginConverter Plugin=MythosHelper_Loki, Converter=MultiplyConverter}, ConverterParameter=0.35}"
                                                                   MaxHeight="120"
                                                                   Source="{ThemeFileBinding Name, PathFormat='Images/AgeRating/{0}.png'}"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   SnapsToDevicePixels="True"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                                                        </Grid>

                                <!-- ROW 2: MAIN DETAILS CONTENT SECTION (70/30 PROPORTION) -->
                                <Grid Grid.Row="2" Panel.ZIndex="0" HorizontalAlignment="Stretch" Margin="60,30,60,0" SnapsToDevicePixels="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Sidebar Column -->
                                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0">
                                        
                                        <!-- HowLongToBeat -->
                                            <StackPanel Margin="0,0,0,25">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=HowLongToBeat, Path=HasData, FallbackValue=False}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="Transparent" Margin="0">

                                                    <StackPanel Margin="0" SnapsToDevicePixels="True">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="Label" x:Key="HltbGridLabelStyle">
                                                                <Setter Property="FontSize" Value="{DynamicResource FontSizeSmaller}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource IdleBrush}"/>
                                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </Style>
                                                            <Style TargetType="Border" x:Key="HltbMainStyle">
                                                                <Setter Property="Background" Value="#008272"/>
                                                                <Setter Property="CornerRadius" Value="8,0,0,8"/>
        							<Setter Property="BorderBrush" Value="{DynamicResource ControlIdleBorderBrush}"/>
								<Setter Property="BorderThickness" Value="0,0,1,0"/>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </Style>
                                                            <Style TargetType="Border" x:Key="HltbExtraStyle">
                                                                <Setter Property="Background" Value="#0078d4"/>
                                                                <Setter Property="CornerRadius" Value="0"/>
        							<Setter Property="BorderBrush" Value="{DynamicResource ControlIdleBorderBrush}"/>
								<Setter Property="BorderThickness" Value="0,0,1,0"/>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </Style>
                                                            <Style TargetType="Border" x:Key="HltbCompStyle">
                                                                <Setter Property="Background" Value="#2ea855"/>
                                                                <Setter Property="CornerRadius" Value="0,8,8,0"/>
        							<Setter Property="BorderBrush" Value="{DynamicResource ControlIdleBorderBrush}"/>
								<Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </Style>
                                                            <Style TargetType="TextBlock" x:Key="HltbGridTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="Margin" Value="8,8,8,8" />
                                                                <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}"/>
                                                                <Setter Property="FontWeight" Value="Medium"/>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </Style>
                                                        </StackPanel.Resources>

                                                        <Grid Margin="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Margin="0,0,0,0">
                                                                <Label Margin="0,0,0,2" Content="{DynamicResource LOCMythos_HLTB_Main}"
                                                                       Style="{DynamicResource HltbGridLabelStyle}"
                                                                       Visibility="Visible" />
                                                                <Border Style="{DynamicResource HltbMainStyle}">
                                                                    <TextBlock Name="MainStoryFormat" Style="{DynamicResource HltbGridTextStyle}"
                                                                               Text="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat, FallbackValue='--'}"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Margin="0,0,0,0">

                                                                <Label Margin="0,0,0,2" Content="{DynamicResource LOCMythos_HLTB_MainPlus}"
                                                                       Style="{DynamicResource HltbGridLabelStyle}"
                                                                       Visibility="Visible" />
                                                                <Border Style="{DynamicResource HltbExtraStyle}">
                                                                    <TextBlock Name="MainExtraFormat"
                                                                               Style="{DynamicResource HltbGridTextStyle}"
                                                                               Text="{PluginSettings Plugin=HowLongToBeat, Path=MainExtraFormat, FallbackValue='--'}"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Margin="0,0,0,0">

                                                                <Label Margin="0,0,0,2" Content="{DynamicResource LOCMythos_HLTB_Completionist}"
                                                                       Style="{DynamicResource HltbGridLabelStyle}"
                                                                       Visibility="Visible" />
                                                                <Border Style="{DynamicResource HltbCompStyle}">
                                                                    <TextBlock Name="CompletionistFormat"
                                                                               Style="{DynamicResource HltbGridTextStyle}"
                                                                               Text="{PluginSettings Plugin=HowLongToBeat, Path=CompletionistFormat, FallbackValue='--'}"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        <!-- Game Details / Properties Card -->
                                        <Border Margin="0,0,0,20"
                                                Background="#08FFFFFF"
                                                BorderBrush="{DynamicResource ContentBorderBrushOverlay}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource GridCornerRadius}"
                                                Padding="16,14,16,10">
                                            <StackPanel>
                                                <!-- Header -->
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{DynamicResource LOCGameDetailsTitle}"
                                                               Foreground="{DynamicResource SubtalBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <StackPanel Grid.IsSharedSizeScope="True">
                                                    <StackPanel.Resources>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="0,0,0,0" />
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="FlowDirection" Value="RightToLeft"/>
                                                </Style>
                                                <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                                                    <Setter Property="Margin" Value="0,0,12,0" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                    <Setter Property="MaxWidth" Value="140"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                </Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PropertyItemButton}">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="0,0,0,0" />
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" >
                                                            <Setter Property="Margin" Value="0,0,0,0" />
                                                    	<Setter Property="HorizontalAlignment" Value="Right"/>
                                                        </Style>
                                            </StackPanel.Resources>

                                                    <!-- User Score -->
                                                    <Border x:Name="PART_ElemUserScore" Padding="0,11,0,11" BorderBrush="{DynamicResource ContentBorderBrushOverlay}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCMythos_UserRating}" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right"
                                                                        Visibility="{Binding ElementName=PART_TextUserScore, Path=Visibility}">
                                                                <ContentControl Content="{Binding Game.UserScore}"
                                                                                Padding="6,0,0,4"
                                                                                Margin="0,0,0,-1"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                Background="Transparent"
                                                                                Foreground="{Binding ElementName=PART_TextUserScore, Path=Foreground}"
                                                                                Height="16"
                                                                                ContentTemplate="{StaticResource FiveStarScore}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Critic Score -->
                                                    <Border x:Name="PART_ElemCriticScore" Padding="0,11,0,11" BorderBrush="{DynamicResource ContentBorderBrushOverlay}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCMythos_CriticRating}" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right"
                                                                        Visibility="{Binding ElementName=PART_TextCriticScore, Path=Visibility}">
                                                                <ContentControl Content="{Binding Game.CriticScore}"
                                                                                Padding="6,0,0,4"
                                                                                Margin="0,0,0,-1"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                Background="Transparent"
                                                                                Foreground="{Binding ElementName=PART_TextCriticScore, Path=Foreground}"
                                                                                Height="16"
                                                                                ContentTemplate="{StaticResource FiveStarScore}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Community Score -->
                                                    <Border x:Name="PART_ElemCommunityScore" Padding="0,11,0,11" BorderBrush="{DynamicResource ContentBorderBrushOverlay}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCMythos_CommRating}" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right"
                                                                        Visibility="{Binding ElementName=PART_TextCommunityScore, Path=Visibility}">
                                                                <ContentControl Content="{Binding Game.CommunityScore}"
                                                                                Padding="6,0,0,4"
                                                                                Margin="0,0,0,-1"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                Background="Transparent"
                                                                                Foreground="{Binding ElementName=PART_TextCommunityScore, Path=Foreground}"
                                                                                Height="16"
                                                                                ContentTemplate="{StaticResource FiveStarScore}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    

                                                    <!-- Developers -->
                                                    <Border x:Name="PART_ElemDevelopers" Padding="0,11,0,11" BorderBrush="{DynamicResource ContentBorderBrushOverlay}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCDeveloperLabel}" VerticalAlignment="Center"/>
                                                            <ItemsControl Grid.Column="1" Name="PART_ItemsDevelopers" HorizontalAlignment="Right" Margin="0,-4,4,0"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Publishers -->
                                                    <Border x:Name="PART_ElemPublishers" Padding="0,11,0,11" BorderBrush="{DynamicResource ContentBorderBrushOverlay}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCPublisherLabel}" VerticalAlignment="Center"/>
                                                            <ItemsControl Grid.Column="1" Name="PART_ItemsPublishers" HorizontalAlignment="Right" Margin="0,-4,4,0"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Source -->
                                                    <Border x:Name="PART_ElemSource" Padding="0,11,0,11" BorderBrush="{DynamicResource ContentBorderBrushOverlay}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCSourceLabel}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Name="PART_ButtonSource" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Release Date -->
                                                    <Border x:Name="PART_ElemReleaseDate" Padding="0,11,0,11" BorderBrush="{DynamicResource ContentBorderBrushOverlay}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCGameReleaseDateTitle}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Name="PART_ButtonReleaseDate" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Region -->
                                                    <Border x:Name="PART_ElemRegion" Padding="0,11,0,11" BorderBrush="{DynamicResource ContentBorderBrushOverlay}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCRegionLabel}" VerticalAlignment="Center"/>
                                                            <ItemsControl Grid.Column="1" Name="PART_ItemsRegions" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Added -->
                                                    <Border x:Name="PART_ElemAdded" Padding="0,11,0,11" BorderBrush="{DynamicResource ContentBorderBrushOverlay}" BorderThickness="0,0,0,1" >
