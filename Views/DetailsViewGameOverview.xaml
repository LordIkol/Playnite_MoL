                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCDateAddedLabel}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Name="PART_TextAdded" HorizontalAlignment="Right" Margin="0,0,4,0" />
                                                        </Grid>
                                                    </Border>

                                                    

                                                    <!-- Library -->
                                                    <Border x:Name="PART_ElemLibrary" Padding="0,11,0,11" BorderBrush="{DynamicResource ContentBorderBrushOverlay}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCGameProviderTitle}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Name="PART_ButtonLibrary" HorizontalAlignment="Right" Margin="0,0,4,0" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Platform -->
                                                    <Border x:Name="PART_ElemPlatform" Padding="0,11,0,11" BorderBrush="{DynamicResource ContentBorderBrushOverlay}" BorderThickness="0,0,0,1" >
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0" Content="{DynamicResource LOCGamePlatformTitle}" VerticalAlignment="Center"/>
                                                            <!--<ItemsControl Grid.Column="1" Name="PART_ItemsPlatforms" HorizontalAlignment="Right" Margin="0,0,4,0"/>-->
                                                            <Image Grid.Column="1"
                                                                Source="{ThemeFileBinding Game.Platforms[0].SpecificationId, PathFormat='Icons/Labels/{0}.png'}"
                                                                HorizontalAlignment="Right"
                                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                                Height="18"
                                                                MaxWidth="84"
                                                                Margin="0,0,5,0"/>
                                                        </Grid>
                                                    </Border>
                                        </StackPanel>
                                            </StackPanel>
                                        </Border>

					</StackPanel>
                                    <!--Right Side Ends-->

                                    <!--Left Side-->
                                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,32,0">

                                        <Grid x:Name="MediaPreviewGrid" MaxHeight="340" MaxWidth="580" HorizontalAlignment="Left" Margin="0,0,0,20">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableVideoPlayer, FallbackValue=False}" Value="True"/>
                                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsAnyVideoAvailable, FallbackValue=False}" Value="True"/>
                                                                <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableAlternativeDetailsVideoPlayer, FallbackValue=False}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <!-- Video Feed Grid -->
                                            <Grid x:Name="VideoFeed">

                                                <Viewbox Stretch="Uniform" Visibility="Visible">
                                                    <Rectangle Width="16" Height="9" Fill="Transparent" IsHitTestVisible="False"/>
                                                </Viewbox>

                                                <Image Source="{ThemeFile 'Images/Fallback.png'}"
                                                    Stretch="Uniform"
                                                    IsHitTestVisible="False">
                                                <Image.OpacityMask>
                                                    <VisualBrush>
                                                        <VisualBrush.Visual>
                                                            <Border Background="Black"
                                                                    CornerRadius="{DynamicResource VideoCornerRadius}"
                                                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Image}}"
                                                                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Image}}"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Image.OpacityMask>
                                            </Image>

                                            <ContentControl x:Name="ExtraMetadataLoader_VideoLoaderControl"
                                                            Width="{Binding ActualWidth, ElementName=VideoDisplayGrid}"
                                                            Height="{Binding ActualHeight, ElementName=VideoDisplayGrid}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top"
                                                            Margin="0,-9999,0,0"/>

                                            <Grid>
                                                <Grid x:Name="VideoDisplayGrid">
                                                    <Grid.OpacityMask>
                                                        <VisualBrush>
                                                            <VisualBrush.Visual>
                                                                <Border Background="Black"
                                                                        CornerRadius="{DynamicResource VideoCornerRadius}"
                                                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Grid.OpacityMask>
                                                    <Viewbox Stretch="Uniform">
                                                        <Rectangle Width="16" Height="9" Fill="Transparent" IsHitTestVisible="False"/>
                                                    </Viewbox>
                                                    <Rectangle>
                                                        <Rectangle.Fill>
                                                            <VisualBrush Visual="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl}"
                                                                        Stretch="Uniform"
                                                                        AlignmentX="Center"
                                                                        AlignmentY="Center"/>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </Grid>
                                            </Grid>

                                            <Grid HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                x:Name="ControlsOverlay">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                            To="1" Duration="0:0:0.3"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                            To="0" Duration="0:0:0.3"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <Viewbox Stretch="Uniform">
                                                    <Rectangle Width="16" Height="9" Fill="Transparent" IsHitTestVisible="True"/>
                                                </Viewbox>

                                                <!-- Play/Pause buttons -->
                                                <Grid HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Margin="20"
                                                    IsHitTestVisible="True">

                                                    <!-- Play button -->
                                                    <Button Width="40" Height="40"
                                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                            FontSize="16"
                                                            Cursor="Hand"
                                                            Content="&#xF5B0;"
                                                            Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoPlayCommand}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="{DynamicResource ControlIdleBackgroundBrushOverlay}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlIdleBorderBrushOverlay}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    CornerRadius="20"
                                                                                    Width="{TemplateBinding Width}"
                                                                                    Height="{TemplateBinding Height}"
                                                                                    RenderTransformOrigin="0.5,0.5">
                                                                                <Border.RenderTransform>
                                                                                    <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                                                                                </Border.RenderTransform>
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Trigger.EnterActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.1"/>
                                                                                                <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.1"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.EnterActions>
                                                                                    <Trigger.ExitActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>
                                                                                                <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.ExitActions>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.SettingsModel.Settings.IsVideoPlaying}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Pause button -->
                                                    <Button Width="40" Height="40"
                                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                            FontSize="16"
                                                            Cursor="Hand"
                                                            Content="&#xE769;"
                                                            Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoPauseCommand}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="{DynamicResource ControlIdleBackgroundBrushOverlay}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlIdleBorderBrushOverlay}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    CornerRadius="20"
                                                                                    Width="{TemplateBinding Width}"
                                                                                    Height="{TemplateBinding Height}"
                                                                                    RenderTransformOrigin="0.5,0.5">
                                                                                <Border.RenderTransform>
                                                                                    <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                                                                                </Border.RenderTransform>
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Trigger.EnterActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.1"/>
                                                                                                <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.1"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.EnterActions>
                                                                                    <Trigger.ExitActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>
                                                                                                <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.ExitActions>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.SettingsModel.Settings.IsVideoPlaying}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>

                                                <!-- Mute toggle -->
                                                <ToggleButton Width="40" Height="40"
                                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                            FontSize="18"
                                                            Cursor="Hand"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom"
                                                            Margin="70,0,0,20"
                                                            Command="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.VideoMuteCommand}">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="IsChecked" Value="{Binding ElementName=ExtraMetadataLoader_VideoLoaderControl, Path=Content.IsPlayerMuted, Mode=OneWay}"/>
                                                            <Setter Property="Background" Value="{DynamicResource ControlIdleBackgroundBrushOverlay}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ControlIdleBorderBrushOverlay}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border x:Name="border"
                                                                                Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="20"
                                                                                Width="{TemplateBinding Width}"
                                                                                Height="{TemplateBinding Height}"
                                                                                RenderTransformOrigin="0.5,0.5">
                                                                            <Border.RenderTransform>
                                                                                <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                                                                            </Border.RenderTransform>
                                                                            <TextBlock x:Name="Icon"
                                                                                    Text="&#xE767;"
                                                                                    FontFamily="{TemplateBinding FontFamily}"
                                                                                    FontSize="{TemplateBinding FontSize}"
                                                                                    Foreground="{TemplateBinding Foreground}"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Trigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.1"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.1"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </Trigger.EnterActions>
                                                                                <Trigger.ExitActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>
                                                                                            <DoubleAnimation Storyboard.TargetName="scaleTransform" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </Trigger.ExitActions>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                                                                <Setter TargetName="Icon" Property="Text" Value="&#xE74F;"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False">
                                                                                <Setter TargetName="Icon" Property="Text" Value="&#xE767;"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>

                                                <!-- Top gradient overlay -->
                                                <Grid HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Top"
                                                    IsHitTestVisible="False">
                                                    <Border Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                            HorizontalAlignment="Stretch"
                                                            Background="{DynamicResource TitleOverlayGradient}"
                                                            CornerRadius="{DynamicResource VideoControlsCornerRadius}"
                                                            IsHitTestVisible="False"/>
                                                </Grid>

                                            </Grid>
                                            </Grid>
                                            <!-- End of VideoFeed -->
                                        </Grid>

                                        <Grid x:Name="SteamLinksBorder"
                                            Tag="{DynamicResource DetailsViewSteamLinksBar}"
                                            Margin="0,15,0,0">

                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding Game.Links[0].Name}" Value="Store Page"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding Game.Links[1].Name}" Value="Store Page"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding Game.Links[2].Name}" Value="Store Page"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding Game.Links[3].Name}" Value="Store Page"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding Game.Links[4].Name}" Value="Store Page"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding Game.Links[5].Name}" Value="Store Page"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding Game.Links[6].Name}" Value="Store Page"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding Game.Links[7].Name}" Value="Store Page"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding Game.Links[8].Name}" Value="Store Page"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding Game.Links[9].Name}" Value="Store Page"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>

                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                <Condition Binding="{Binding Game.Links[10].Name}" Value="Store Page"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>

                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Border x:Name="SteamLinksBackground"
                                                    Tag="{DynamicResource AccentColorOverride}"
                                                    CornerRadius="{DynamicResource SteamLinksBorderCornerRadius}">

                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SteamButtonBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentIdleBrush}"/>
                                                                <Setter Property="Opacity" Value="0.25"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                            </Border>

                                            <!-- Content -->
                                            <Grid Margin="0,2,0,2">
                                                <Image Source="{ThemeFile 'Images/Links/SteamPanel.png'}"
                                                    RenderOptions.BitmapScalingMode="Fant"
                                                    SnapsToDevicePixels="True"
                                                    Width="26"
                                                    Height="26"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Margin="8,0,0,0"
                                                    Opacity="1"
                                                    IsHitTestVisible="False"/>

                                                <StackPanel x:Name="PART_SteamLinksPanel"
                                                            Margin="20,0,0,0"
                                                            Visibility="Visible">

                                                    <ItemsControl ItemsSource="{Binding Game.Links}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type Link}">
                                                                <Button x:Name="LinkButton"
                                                                        Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.OpenLinkCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Margin="2"
                                                                        Padding="10,8"
                                                                        Background="Transparent"
                                                                        Foreground="{DynamicResource TextBrush}"
                                                                        BorderThickness="0"
                                                                        BorderBrush="{DynamicResource ControlIdleBorderBrush}"
                                                                        FontSize="{DynamicResource FontSize}"
                                                                        Cursor="Hand"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="Collapsed">

                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Border"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    CornerRadius="{DynamicResource ControlCornerRadiusMedium}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Margin="{TemplateBinding Padding}"/>
                                                                            </Border>

                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ContentBorderBrushOverlay}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>

                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock x:Name="Icon"
                                                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                                FontSize="14"
                                                                                Margin="0,0,8,0"
                                                                                VerticalAlignment="Center"
                                                                                Text="&#xE71B;"/>
                                                                        <TextBlock x:Name="LabelText"
                                                                                VerticalAlignment="Center"
                                                                                FontWeight="SemiBold"
                                                                                Text="{Binding Name}"/>
                                                                    </StackPanel>
                                                                </Button>

                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Name}" Value="News">
                                                                        <Setter TargetName="LinkButton" Property="Visibility" Value="Visible"/>
                                                                        <Setter TargetName="Icon" Property="Text" Value="&#xEA89;"/>
                                                                        <Setter TargetName="LabelText" Property="Text" Value="{DynamicResource LOCMythos_SteamNews}"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Name}" Value="Guides">
                                                                        <Setter TargetName="LinkButton" Property="Visibility" Value="Visible"/>
                                                                        <Setter TargetName="Icon" Property="Text" Value="&#xE729;"/>
                                                                        <Setter TargetName="LabelText" Property="Text" Value="{DynamicResource LOCMythos_SteamGuides}"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Name}" Value="Discussions">
                                                                        <Setter TargetName="LinkButton" Property="Visibility" Value="Visible"/>
                                                                        <Setter TargetName="Icon" Property="Text" Value="&#xF8B2;"/>
                                                                        <Setter TargetName="LabelText" Property="Text" Value="{DynamicResource LOCMythos_SteamDiscussions}"/>
                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding Name}" Value="Community Hub">
                                                                        <Setter TargetName="LinkButton" Property="Visibility" Value="Visible"/>
                                                                        <Setter TargetName="Icon" Property="Text" Value="&#xEA8C;"/>
                                                                        <Setter TargetName="LabelText" Property="Text" Value="{DynamicResource LOCMythos_SteamCommunity}"/>
